APP_ENV=development
PORT=8080
METRICS_PORT=9091
DATABASE_URL=postgres://streampulse:streampulse@localhost:5432/streampulse?sslmode=disable
JWT_SECRET=your-super-secret-key-change-in-production
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=168h
OTEL_ENDPOINT=otel-collector:4317
OTEL_SERVICE_NAME=streampulse-api
LOG_LEVEL=debug
# json (indexable, defaut) | console (lisible en dev local)
LOG_FORMAT=json
# Origines CORS, separees par des virgules. Le joker convient au dev local ;
# avec APP_ENV=production le serveur refuse de demarrer tant que les origines
# de la console web ne sont pas nommees (ex. https://console.example.com).
CORS_ALLOWED_ORIGINS=*
RATE_LIMIT_RPS=10
RATE_LIMIT_BURST=20
# Reverse-proxies dont X-Forwarded-For est accepte (CIDR ou adresse,
# separes par des virgules). Vide = aucun en-tete de transmission n'est
# cru, ce qui est le reglage sur pour un serveur expose directement.
TRUSTED_PROXIES=
HTTP_READ_TIMEOUT=30s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=60s
# HTTPS natif : renseigner les deux pour servir en TLS, laisser vides derriere
# un reverse proxy qui termine TLS (voir docs/deployment.md)
TLS_CERT_FILE=
TLS_KEY_FILE=
# URL publique de l'API pour les liens des fichiers uploades. Vide : deduite
# du port et de TLS (http(s)://localhost:PORT)
PUBLIC_BASE_URL=
# Purge des refresh tokens expires (politique de retention, docs/rgpd.md)
REFRESH_TOKEN_PURGE_INTERVAL=1h
# Delai avant l'arret automatique d'un direct dont le diffuseur a disparu
# (POST /broadcast termine sans remplacant). Doit depasser le delai de
# reconnexion de l'app mobile (2 s)
BROADCAST_GRACE_PERIOD=10s
# Connexion sociale : client IDs OAuth acceptes comme audience des ID tokens,
# separes par des virgules. Google : client web + client iOS (console Google
# Cloud). Apple : bundle id de l'app (dev.streampulse.app) et, pour le web,
# le Service ID (portail Apple Developer). Vide = fournisseur desactive,
# POST /auth/oauth repond alors 503 pour lui.
GOOGLE_OAUTH_CLIENT_IDS=
APPLE_OAUTH_CLIENT_IDS=
